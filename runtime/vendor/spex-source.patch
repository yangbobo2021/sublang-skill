index 00000000..284c3003
--- /dev/null
+++ b/packages/core/src/runtime-info.ts
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>
+
+// Read actual resolution from the serving Core and each registry's import
+// locations. Do not infer it from the caller's npm tree or package metadata.
+import { existsSync, readFileSync, realpathSync } from "node:fs";
+import { createRequire } from "node:module";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { shippedBuiltinPackage } from "./builtins.js";
+
+export function resolvedPackage(from: string, specifier: string) {
+  const entry = realpathSync(createRequire(from).resolve(specifier));
+  let dir = dirname(entry);
+  for (;;) {
+    const manifest = join(dir, "package.json");
+    if (existsSync(manifest)) {
+      const data = JSON.parse(readFileSync(manifest, "utf8"));
+      if (data.name) return { name: String(data.name), version: String(data.version), root: realpathSync(dir), entry };
+    }
+    const parent = dirname(dir);
+    if (parent === dir) throw new Error(`No package manifest for ${specifier}`);
+    dir = parent;
+  }
+}
+
+// Follow local static imports, including the built-in registry's sibling
+// .playbook.js. Never walk node_modules or execute a workflow for diagnosis.
+function engineImports(module: string) {
+  const imports: { importer: string; specifier: string; resolved?: ReturnType<typeof resolvedPackage>; error?: string }[] = [];
+  const visited = new Set<string>();
+  const visit = (file: string) => {
+    file = realpathSync(file);
+    if (visited.has(file)) return;
+    visited.add(file);
+    if (visited.size > 500) throw new Error("Registry import graph exceeds diagnostic limit");
+    const source = readFileSync(file, "utf8");
+    for (const match of source.matchAll(/(?:\bfrom\s*|\bimport\s*\(?\s*|\brequire\s*\(\s*)["']([^"'\s]+)["']/g)) {
+      const specifier = match[1]!;
+      if (/^(?:@sublang\/playbook|xstate)(?:\/|$)/.test(specifier)) {
+        try { imports.push({ importer: file, specifier, resolved: resolvedPackage(file, specifier) }); }
+        catch (error) { imports.push({ importer: file, specifier, error: (error as Error).message }); }
+      } else if (specifier.startsWith(".")) {
+        const child = resolve(dirname(file), specifier);
+        if (/\.(?:mjs|cjs|js)$/.test(child) && existsSync(child)) visit(child);
+      }
+    }
+  };
+  visit(module);
+  return imports;
+}
+
+export function runtimeInfo(placed: readonly { id: string; package: string; version: string; module: string; present: boolean; repository: string }[]) {
+  const from = fileURLToPath(import.meta.url);
+  const packages = Object.fromEntries(["@sublang/spex/environment", "@sublang/playbook/xstate-runtime", "xstate"].map(name => [name, resolvedPackage(from, name)]));
+  const buildFile = join(dirname(from), "..", "assets", "skill-runtime.json");
+  const cliBuildFile = join(packages["@sublang/spex/environment"]!.root, "dist", "skill-runtime.js");
+  const cliBuild = existsSync(cliBuildFile) ? JSON.parse(readFileSync(cliBuildFile, "utf8").replace(/^export default /, "").replace(/;\s*$/, "")) : null;
+  return {
+    core: { root: realpathSync(join(dirname(from), "..")), build: existsSync(buildFile) ? JSON.parse(readFileSync(buildFile, "utf8")) : null },
+    packages,
+    cliBuild,
+    builtin: shippedBuiltinPackage(),
+    workflows: placed.map(row => {
+      let imports: ReturnType<typeof engineImports> = [], error: string | undefined;
+      if (row.present) {
+        try { imports = engineImports(row.module); } catch (cause) { error = (cause as Error).message; }
+      }
+      const playbook = imports.filter(i => i.specifier.startsWith("@sublang/playbook"));
+      const aligned = row.present && !error && playbook.length > 0 && imports.every(i => i.resolved && i.resolved.root === packages[i.specifier.startsWith("@sublang/playbook") ? "@sublang/playbook/xstate-runtime" : "xstate"]!.root);
+      return { ...row, imports, status: !row.present ? "missing" : aligned ? "aligned" : "unverified", ...(error ? { error } : {}) };
+    }),
+  };
+}
