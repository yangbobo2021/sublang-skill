+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>
+
+import { randomUUID } from "node:crypto";
+import { chmodSync, lstatSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { PROTOCOL_VERSION } from "./protocol.js";
+
+/** Local non-browser clients join the root's existing writer. The bearer
+ * remains in private local storage, never in protocol replies or logs. */
+export function publishLocalEndpoint(root: string, port: number, token: string): () => void {
+  const dir = join(root, "local");
+  mkdirSync(dir, { recursive: true, mode: 0o700 });
+  const stat = lstatSync(dir);
+  if (!stat.isDirectory() || stat.isSymbolicLink()) throw new Error("Local endpoint directory is not a plain directory");
+  const file = join(dir, "agent-endpoint.json");
+  const identity = randomUUID();
+  const bytes = JSON.stringify({ format: 1, identity, pid: process.pid, port, token, protocolVersion: PROTOCOL_VERSION });
+  const temporary = join(dirname(file), `.agent-endpoint-${identity}.tmp`);
+  try {
+    writeFileSync(temporary, bytes, { flag: "wx", mode: 0o600 });
+    if (process.platform !== "win32") chmodSync(temporary, 0o600);
+    renameSync(temporary, file);
+  } finally { rmSync(temporary, { force: true }); }
+  return () => {
+    try {
+      if (JSON.parse(readFileSync(file, "utf8")).identity === identity) rmSync(file);
+    } catch { /* A changed/unreadable descriptor is never ours to remove. */ }
+  };
+}
