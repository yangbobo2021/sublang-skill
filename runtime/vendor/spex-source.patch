@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: 2026 SubLang International <https://sublang.ai>
+
+import { readdirSync, statSync, watch, type FSWatcher } from "node:fs";
+import { join } from "node:path";
+
+export interface DirectoryWatcher { close(): void }
+
+// A sandbox can reject native notifications asynchronously as EMFILE even
+// with a high descriptor limit. Keep changes observable without changing
+// permissions, requiring a higher ulimit, or losing the Core process.
+export function watchDirectory(dir: string, changed: (event: string, filename: string | null) => void): DirectoryWatcher {
+  let closed = false;
+  let native: FSWatcher | undefined;
+  let poll: ReturnType<typeof setInterval> | undefined;
+  const snapshot = (): string => {
+    try {
+      return readdirSync(dir).sort().map(name => {
+        try {
+          const s = statSync(join(dir, name));
+          return `${name}:${s.ino}:${s.size}:${s.mtimeMs}:${s.ctimeMs}`;
+        } catch { return `${name}:missing`; }
+      }).join("\n");
+    } catch (error) { return `unavailable:${(error as NodeJS.ErrnoException).code}`; }
+  };
+  let before = snapshot();
+  const fallback = (error: NodeJS.ErrnoException) => {
+    native?.close(); native = undefined;
+    if (closed || poll) return;
+    console.warn(`spex: native file notifications unavailable (${error.code ?? "unknown"}); polling ${dir}`);
+    poll = setInterval(() => {
+      const after = snapshot();
+      if (after === before) return;
+      before = after;
+      changed("change", null);
+    }, 500);
+    poll.unref();
+  };
+  try {
+    native = watch(dir, changed);
+    native.on("error", fallback);
+  } catch (error) { fallback(error as NodeJS.ErrnoException); }
+  return { close() {
+    if (closed) return;
+    closed = true;
+    native?.close();
+    if (poll) clearInterval(poll);
+  } };
+}
